# PostgreSQL + PostGIS (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://geoagentic:geoagentic@localhost:5432/geoagentic

# OSRM routing engine. Public demo server needs no setup; swap to
# http://localhost:5000 once you run the optional local-osrm profile.
OSRM_BASE_URL=https://router.project-osrm.org

# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Detection thresholds (match the project spec)
DEVIATION_BUFFER_METERS=50
CIVILIAN_ALERT_RADIUS_METERS=500
TELEMETRY_INTERVAL_SECONDS=2

# CORS - add your deployed frontend URLs here, comma separated
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
